Subject: Build ElegooLink wrapper without cloud API

With ENABLE_CLOUD_FEATURES off, elegoo-link does not declare its cloud
methods. Return OPERATION_NOT_IMPLEMENTED for the cloud operations
instead. With cloud features on, the code is unchanged.
---
diff --git a/src/slic3r/Utils/Elegoo/ElegooLink.cpp b/src/slic3r/Utils/Elegoo/ElegooLink.cpp
index eafc2bca..748f56fb 100644
--- a/src/slic3r/Utils/Elegoo/ElegooLink.cpp
+++ b/src/slic3r/Utils/Elegoo/ElegooLink.cpp
@@ -255,6 +255,7 @@ void ElegooLink::init(const std::string& region, std::string& iotUrl, const std:
     auto webDir = resources_dir();
     std::replace(webDir.begin(), webDir.end(), '\\', '/');
     cfg.local.staticWebPath = webDir + "/plugins/elegoolink/web";
+#ifdef ENABLE_CLOUD_FEATURES
     cfg.cloud.staticWebPath = cfg.local.staticWebPath;
     std::string caCertDir = resources_dir();
     std::replace(caCertDir.begin(), caCertDir.end(), '\\', '/');
@@ -264,6 +265,7 @@ void ElegooLink::init(const std::string& region, std::string& iotUrl, const std:
     cfg.cloud.userAgent = build_cloud_user_agent();
     cfg.cloud.region = region;
     cfg.cloud.baseApiUrl = iotUrl;
+#endif
     if (!elink::ElegooLink::getInstance().initialize(cfg)) {
         BOOST_LOG_TRIVIAL(error) << __FUNCTION__ << ": error initializing ElegooLink";
     }
@@ -439,6 +441,10 @@ PrinterNetworkResult<PrinterNetworkInfo> ElegooLink::connectToPrinter(const Prin
 }
 PrinterNetworkResult<PrinterNetworkInfo> ElegooLink::bindWANPrinter(const PrinterNetworkInfo& printerNetworkInfo)
 {
+#ifndef ENABLE_CLOUD_FEATURES
+    // Cloud features are disabled in this build (no proprietary Agora SDK).
+    return PrinterNetworkResult<PrinterNetworkInfo>(PrinterNetworkErrorCode::OPERATION_NOT_IMPLEMENTED, PrinterNetworkInfo{});
+#else
     CHECK_INITIALIZED(printerNetworkInfo);
     PrinterNetworkErrorCode  resultCode = PrinterNetworkErrorCode::UNKNOWN_ERROR;
     elink::BindPrinterResult elinkResult;
@@ -486,6 +492,7 @@ PrinterNetworkResult<PrinterNetworkInfo> ElegooLink::bindWANPrinter(const Printe
         resultCode = PrinterNetworkErrorCode::PRINTER_NETWORK_EXCEPTION;
     }
     return PrinterNetworkResult<PrinterNetworkInfo>(resultCode, printerNetworkInfo, parseUnknownErrorMsg(resultCode, elinkResult.message));
+#endif
 }
 
